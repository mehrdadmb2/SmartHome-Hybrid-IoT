    std::function<void(String, String)> listDir = [&](String dirPath, String base) {
      File dir = SD.open(dirPath);
      if (!dir || !dir.isDirectory()) return;
      while (File entry = dir.openNextFile()) {
        String fullPath = base + "/" + entry.name();
        fullPath.replace("//", "/");
        JsonObject item = items.createNestedObject();
        item["name"] = entry.name();
        item["path"] = fullPath;
        item["size"] = entry.size();
        item["is_dir"] = entry.isDirectory();
        if (entry.isDirectory()) {
          listDir(fullPath, fullPath);
        }
        entry.close();
      }
      dir.close();
    };
    listDir("/", "");
    String out; serializeJson(doc, out);
    request->send(200, "application/json", out);
  });

  server.on("/api/download", HTTP_GET, [](AsyncWebServerRequest *request){
    if (!request->hasParam("path")) return request->send(400);
    String path = request->getParam("path")->value();
    if (path.indexOf("..") != -1 || !path.startsWith("/")) return request->send(403);
    if (!SD.exists(path)) return request->send(404);
    request->send(SD, path, "application/octet-stream", true);
  });

  server.on("/api/upload", HTTP_POST, [](AsyncWebServerRequest *request){ request->send(200); },
    [](AsyncWebServerRequest *request, String filename, size_t index, uint8_t *data, size_t len, bool final){
      static File uploadFile;
      if (!index) {
        String uploadDir = "/www/";
        if (request->hasParam("dir")) { uploadDir = request->getParam("dir")->value(); if (!uploadDir.endsWith("/")) uploadDir += "/"; }
        String path = uploadDir + filename;
        if (SD.exists(path)) SD.remove(path);
        uploadFile = SD.open(path, FILE_WRITE);
      }
      if (uploadFile) { uploadFile.write(data, len); if (final) uploadFile.close(); }
    }
  );

  server.on("/api/delete", HTTP_GET, [](AsyncWebServerRequest *request){
    if (!request->hasParam("path")) return request->send(400);
    String path = request->getParam("path")->value();
    if (path.indexOf("..") != -1 || !path.startsWith("/")) return request->send(403);
    if (SD.exists(path)) { SD.remove(path); request->send(200); }
    else request->send(404);
  });

  server.begin();
  Serial.println("Web server started");
}

// ---------- حلقه اصلی ----------
void loop() {
  // بروزرسانی تاریخ و ساعت (هر ۱ ثانیه)
  static unsigned long lastTimeUpdate = 0;
  if (millis() - lastTimeUpdate >= 1000) {
    lastTimeUpdate = millis();
    timeClient.update();
    time_t now = timeClient.getEpochTime();
    struct tm *t = localtime(&now);
    JalaliDate j = gregorianToJalali(t->tm_year + 1900, t->tm_mon + 1, t->tm_mday);
    sprintf(oledDate, "%04d/%02d/%02d", j.year, j.month, j.day);
    sprintf(oledTime, "%02d:%02d:%02d", t->tm_hour, t->tm_min, t->tm_sec);
  }

  // خواندن سنسور محلی هر ۵ ثانیه
  static unsigned long lastLocalRead = 0;
  if (millis() - lastLocalRead >= 5000) {
    lastLocalRead = millis();
    float t = dht.readTemperature();
    float h = dht.readHumidity();
    if (!isnan(t) && !isnan(h)) {
      localTemp = t; localHum = h;
      Serial.printf("DHT: %.1f°C, %.1f%%\n", t, h);
      logSensorCSV("esp32_1", t, h);
      checkAndCleanSD();
    } else {
      Serial.println("DHT read failed – using last values");
    }
  }

  // به‌روزرسانی OLED (همیشه، حتی اگر سنسور خطا بدهد)
  updateOLED(localTemp, localHum);

  while (Serial2.available()) {
    String line = Serial2.readStringUntil('\n'); line.trim();
    if (line.startsWith("DOOR_OPEN:")) {
      lastDoorEvent = millis();
      logDoorEvent(line.substring(10));
    }
  }

  if (millis() - lastS3Poll >= POLL_INTERVAL && WiFi.status() == WL_CONNECTED) {
    lastS3Poll = millis();
    HTTPClient http;
    http.begin("http://192.168.1.115/api/status");
    http.setTimeout(3000);
    int code = http.GET();
    if (code == 200) {
      String payload = http.getString();
      StaticJsonDocument<128> doc;
      if (!deserializeJson(doc, payload)) {
        s3Temp = doc["temp"]; s3Hum = doc["humidity"];
        lastS3Data = millis();
        logSensorCSV("esp32_s3", s3Temp, s3Hum);
        Serial.println("S3 polled successfully");
      }
    } else {
      Serial.printf("S3 poll failed (HTTP %d)\n", code);
    }
    http.end();
  }

  if (millis() - lastGitPush >= PUSH_INTERVAL) {
    lastGitPush = millis();
    if (githubToken.length() > 0 && WiFi.status() == WL_CONNECTED) {
      pushToGitHub();
    }
  }
  yield();
}

// ---------- CSV با تقسیم خودکار ----------
void logSensorCSV(const String& board, float t, float h) {
  String date = getISODate();
  String baseName = "/data/" + board + "_" + date + ".csv";
  String line = getTimeStr() + "," + String(t,1) + "," + String(h,1);
  appendCSV(baseName, line, "time,temperature,humidity");
}

void logDoorEvent(String tag) {
  String date = getISODate();
  String baseName = "/data/door_" + date + ".csv";
  String line = getTimeStr() + ",open," + tag;
  appendCSV(baseName, line, "time,event,tag");
}

void appendCSV(const String& baseFilename, const String& line, const String& header) {
  int part = 1;
  String filename = baseFilename;
  while (SD.exists(filename)) {
    File f = SD.open(filename, FILE_READ);
    if (f) {
      if (f.size() + line.length() + 1 < MAX_CSV_SIZE) {
        f.close();
        break;
      }
      f.close();
    }
    part++;
    filename = baseFilename + "_" + String(part);
  }

  if (!SD.exists(filename)) {
    File f = SD.open(filename, FILE_WRITE);
    if (f) { f.println(header); f.close(); }
  }
  File f = SD.open(filename, FILE_APPEND);
  if (f) { f.println(line); f.close(); }
}

// ---------- بازه‌های زمانی ----------
String getDataRange(const String& board, const String& range, const String& refDate) {
  std::vector<String> dates;
  if (range == "daily") { dates.push_back(refDate); }
  else if (range == "hourly") { dates.push_back(refDate); }
  else {
    int y, m, d;
    sscanf(refDate.c_str(), "%d-%d-%d", &y, &m, &d);
    struct tm tm = {0}; tm.tm_year = y-1900; tm.tm_mon = m-1; tm.tm_mday = d;
    time_t end = mktime(&tm);
    int days = (range == "weekly") ? 7 : 30;
    for (int i = 0; i < days; i++) {
      time_t day = end - i * 86400;
      struct tm *t = localtime(&day);
      char buf[11]; sprintf(buf, "%04d-%02d-%02d", t->tm_year+1900, t->tm_mon+1, t->tm_mday);
      dates.push_back(String(buf));
    }
    std::reverse(dates.begin(), dates.end());
  }

  static DynamicJsonDocument doc(16384);
  doc.clear();
  JsonArray arr = doc.to<JsonArray>();
  for (auto date : dates) {
    File dir = SD.open("/data");
    if (dir && dir.isDirectory()) {
      while (File entry = dir.openNextFile()) {
        String name = entry.name();
        if (name.startsWith(board + "_" + date) && name.endsWith(".csv")) {
          File f = SD.open("/data/" + name);
          if (f) {
            f.readStringUntil('\n');
            while (f.available() && !arr.isNull()) {
              String line = f.readStringUntil('\n'); line.trim();
              if (line.isEmpty()) continue;
              JsonObject obj = arr.createNestedObject();
              int c1 = line.indexOf(','), c2 = line.indexOf(',', c1+1);
              obj["time"] = line.substring(0, c1);
              obj["temp"] = line.substring(c1+1, c2).toFloat();
              obj["humidity"] = line.substring(c2+1).toFloat();
              if (arr.size() > 1000) break;
            }
            f.close();
          }
        }
        entry.close();
      }
      dir.close();
    }
  }
  if (range == "hourly" && arr.size() > 0) {
    String lastTime = arr[arr.size()-1]["time"];
    int h = lastTime.substring(0,2).toInt(), m = lastTime.substring(3,5).toInt(), s = lastTime.substring(6).toInt();
    int cutoffSec = h*3600 + m*60 + s - 3600;
    int i = 0;
    while (i < arr.size()) {
      String t = arr[i]["time"];
      int sec = t.substring(0,2).toInt()*3600 + t.substring(3,5).toInt()*60 + t.substring(6).toInt();
      if (sec < cutoffSec) arr.remove(i); else i++;
    }
  }
  String out; serializeJson(doc, out);
  return out;
}

// ---------- پاک‌سازی SD ----------
void checkAndCleanSD() {
  unsigned long freeKB = (SD.totalBytes() - SD.usedBytes()) / 1024;
  if (freeKB > 1024) return;
  File root = SD.open("/data");
  if (!root || !root.isDirectory()) return;
  std::vector<String> files;
  while (File f = root.openNextFile()) {
    if (!f.isDirectory() && String(f.name()).endsWith(".csv")) files.push_back(f.name());
    f.close();
  }
  root.close();
  std::sort(files.begin(), files.end(), [](String a, String b) {
    String dateA = a.substring(a.lastIndexOf('_')+1).substring(0,10);
    String dateB = b.substring(b.lastIndexOf('_')+1).substring(0,10);
    return dateA < dateB;
  });
  for (auto fname : files) {
    if ((SD.totalBytes() - SD.usedBytes()) / 1024 > 2048) break;
    if (fname.indexOf(getISODate()) != -1) continue;
    SD.remove("/data/" + fname);
    Serial.printf("Deleted old file: %s\n", fname.c_str());
  }
}

// ---------- گیت‌هاب ----------
void pushToGitHub() {
  String date = getISODate();
  String boards[] = {"esp32_1", "esp32_s3", "door"};
  for (auto board : boards) {
    std::vector<String> files;
    File dir = SD.open("/data");
    if (dir && dir.isDirectory()) {
      while (File entry = dir.openNextFile()) {
        String name = entry.name();
        if (name.startsWith(board + "_" + date) && name.endsWith(".csv")) {
          files.push_back("/data/" + name);
        }
        entry.close();
      }
      dir.close();
    }
    std::sort(files.begin(), files.end());

    for (auto filePath : files) {
      String content = readFile(filePath.c_str());
      if (content.isEmpty()) continue;
      String gitPath = "data/" + filePath.substring(filePath.lastIndexOf('/') + 1);
      String sha = getGitSHA(gitPath);
      addGitHubFile(gitPath, content, sha);
      delay(1000);
      yield();
    }
  }

  static DynamicJsonDocument sdDoc(256);
  sdDoc.clear();
  sdDoc["total_mb"] = SD.totalBytes()/(1024*1024);
  sdDoc["used_mb"] = SD.usedBytes()/(1024*1024);
  sdDoc["free_mb"] = (SD.totalBytes() - SD.usedBytes())/(1024*1024);
  String sdjson; serializeJson(sdDoc, sdjson);
  String sha = getGitSHA("sdinfo.json");
  addGitHubFile("sdinfo.json", sdjson, sha);

  unsigned long now = millis();
  bool s3online = (lastS3Data == 0) ? false : (now - lastS3Data < NODE_TIMEOUT * 1000);
  bool dooronline = (lastDoorEvent == 0) ? false : (now - lastDoorEvent < NODE_TIMEOUT * 1000);
  auto epochToISO = [&](unsigned long ms) -> String {
    time_t t = timeClient.getEpochTime() - ((millis() - ms) / 1000);
    struct tm *ti = gmtime(&t);
    char buf[25]; strftime(buf, sizeof(buf), "%Y-%m-%dT%H:%M:%SZ", ti);
    return String(buf);
  };

  static DynamicJsonDocument nodeDoc(256);
  nodeDoc.clear();
  nodeDoc["hub_last_push"] = epochToISO(millis());
  nodeDoc["sensor_s3_last_data"] = (lastS3Data == 0) ? "never" : epochToISO(lastS3Data);
  nodeDoc["door_last_event"] = (lastDoorEvent == 0) ? "never" : epochToISO(lastDoorEvent);
  nodeDoc["hub_online"] = true;
  nodeDoc["s3_online"] = s3online;
  nodeDoc["door_online"] = dooronline;
  String njson; serializeJson(nodeDoc, njson);
  sha = getGitSHA("node_status.json");
  addGitHubFile("node_status.json", njson, sha);
}

String getGitSHA(const String& path) {
  HTTPClient http;
  http.begin(API_BASE_URL + "repos/" + githubUser + "/" + githubRepo + "/contents/" + path + "?ref=" + githubBranch);
  http.addHeader("Authorization", "token " + githubToken);
  http.addHeader("User-Agent", "ESP32-Hub");
  int code = http.GET();
  if (code == 200) {
    StaticJsonDocument<1024> doc;
    deserializeJson(doc, http.getString());
    const char* sha = doc["sha"];
    http.end();
    return sha ? String(sha) : "";
  }
  http.end();
  return "";
}

void addGitHubFile(const String& path, const String& content, const String& sha) {
  static DynamicJsonDocument pushDoc(8192);
  pushDoc.clear();
  size_t encLen = 4 * ((content.length() + 2) / 3);
  unsigned char enc[encLen+1];
  mbedtls_base64_encode(enc, encLen+1, &encLen, (const unsigned char*)content.c_str(), content.length());
  String b64 = String((char*)enc); b64.replace("\n", "");

  HTTPClient http;
  http.begin(API_BASE_URL + "repos/" + githubUser + "/" + githubRepo + "/contents/" + path);
  http.addHeader("Authorization", "token " + githubToken);
  http.addHeader("User-Agent", "ESP32-Hub");
  http.addHeader("Content-Type", "application/json");

  pushDoc["message"] = "auto update";
  pushDoc["content"] = b64;
  pushDoc["branch"] = githubBranch;
  if (sha.length() > 0) pushDoc["sha"] = sha;
  String body;
  if (serializeJson(pushDoc, body) == 0) {
    Serial.println("JSON serialization failed");
    http.end();
    return;
  }
  int code = http.PUT(body);
  Serial.printf("GitHub PUT %s -> %d\n", path.c_str(), code);
  if (code >= 400) Serial.println(http.getString());
  http.end();
}

