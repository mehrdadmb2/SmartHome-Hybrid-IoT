  server.on("/api/stats/door", HTTP_GET, [](AsyncWebServerRequest *request){
    String date = request->hasParam("date") ? request->getParam("date")->value() : getISODate();
    std::map<String, int> tagCount;
    int total = 0;
    File dir = SD.open("/data");
    if (dir && dir.isDirectory()) {
      while (File entry = dir.openNextFile()) {
        String name = entry.name();
        if (name.startsWith("door_" + date) && name.endsWith(".csv")) {
          File f = SD.open("/data/" + name);
          if (f) {
            f.readStringUntil('\n');
            while (f.available()) {
              String line = f.readStringUntil('\n'); line.trim();
              if (line.isEmpty()) continue;
              int c2 = line.indexOf(',', line.indexOf(',')+1);
              String tag = line.substring(c2+1); tag.trim();
              tagCount[tag]++; total++;
            }
            f.close();
          }
        }
        entry.close();
      }
      dir.close();
    }
    StaticJsonDocument<4096> doc;
    doc["date"] = date; doc["total"] = total;
    JsonArray tags = doc.createNestedArray("tags");
    for (auto &p : tagCount) { JsonObject o = tags.createNestedObject(); o["tag"] = p.first; o["count"] = p.second; }
    String out; serializeJson(doc, out);
    request->send(200, "application/json", out);
  });

  server.on("/api/sdinfo", HTTP_GET, [](AsyncWebServerRequest *request){
    StaticJsonDocument<256> doc;
    doc["total_mb"] = SD.totalBytes() / (1024*1024);
    doc["used_mb"] = SD.usedBytes() / (1024*1024);
    doc["free_mb"] = (SD.totalBytes() - SD.usedBytes()) / (1024*1024);
    String out; serializeJson(doc, out);
    request->send(200, "application/json", out);
  });

  server.on("/api/datetime", HTTP_GET, [](AsyncWebServerRequest *request){
    timeClient.update();
    time_t now = timeClient.getEpochTime();
    struct tm *t = localtime(&now);
    char greg[20]; sprintf(greg, "%04d-%02d-%02d %02d:%02d:%02d", t->tm_year+1900, t->tm_mon+1, t->tm_mday, t->tm_hour, t->tm_min, t->tm_sec);
    JalaliDate j = gregorianToJalali(t->tm_year+1900, t->tm_mon+1, t->tm_mday);
    char shamsi[20]; sprintf(shamsi, "%04d-%02d-%02d %02d:%02d:%02d", j.year, j.month, j.day, t->tm_hour, t->tm_min, t->tm_sec);
    StaticJsonDocument<128> doc;
    doc["gregorian"] = greg; doc["shamsi"] = shamsi;
    String out; serializeJson(doc, out);
    request->send(200, "application/json", out);
  });

  server.on("/open", HTTP_GET, [](AsyncWebServerRequest *request){
    Serial2.println("OPEN_DOOR");
    request->send(200);
  });

  server.on("/download/sensor1", HTTP_GET, [](AsyncWebServerRequest *request){ request->send(SD, "/data/esp32_1_" + getISODate() + ".csv", "text/csv", true); });
  server.on("/download/sensor2", HTTP_GET, [](AsyncWebServerRequest *request){ request->send(SD, "/data/esp32_s3_" + getISODate() + ".csv", "text/csv", true); });
