void updateOLED(float t, float h) {
  display.clearDisplay();
  display.drawRect(0, 0, 128, 64, SSD1306_WHITE);
  display.drawLine(0, 34, 128, 34, SSD1306_WHITE);

  // ---------- دما ----------
  display.setTextSize(1);
  display.setCursor(6, 10);
  display.print("Temp:");
  display.setCursor(48, 10);
  display.print(t, 1);
  display.print("C");

  // ---------- رطوبت ----------
  display.setCursor(6, 24);
  display.print("Hum :");
  display.setCursor(48, 24);
  display.print(h, 1);
  display.print("%");

  // ---------- تاریخ و ساعت ----------
  display.setCursor(6, 40);
  display.print(oledDate);
  display.setCursor(72, 40);
  display.print(oledTime);

  display.display();
}

String getISODate() {
  timeClient.update();
  time_t now = timeClient.getEpochTime();
  struct tm *t = localtime(&now);
  char buf[11]; sprintf(buf, "%04d-%02d-%02d", t->tm_year+1900, t->tm_mon+1, t->tm_mday);
  return String(buf);
}

String getTimeStr() {
  timeClient.update();
  time_t now = timeClient.getEpochTime();
  struct tm *t = localtime(&now);
  char buf[9]; sprintf(buf, "%02d:%02d:%02d", t->tm_hour, t->tm_min, t->tm_sec);
  return String(buf);
}
