      File f = root.openNextFile();
      while (f) {
        html += "<li>" + String(f.name()) + " (" + String(f.size()) + " bytes)</li>";
        f = root.openNextFile();
      }
      root.close();
    }
    html += "</ul></body></html>";
    request->send(200, "text/html", html);
  });

  server.on("/api/sensor", HTTP_POST, [](AsyncWebServerRequest *request){
    if (request->hasParam("plain", true)) {
      StaticJsonDocument<200> doc;
      deserializeJson(doc, request->getParam("plain", true)->value());
      if (strcmp(doc["board"], "esp32_s3") == 0) {
        s3Temp = doc["temp"]; s3Hum = doc["humidity"];
        lastS3Data = millis();
        logSensorCSV("esp32_s3", s3Temp, s3Hum);
      }
    }
    request->send(200);
  });

  server.on("/api/current", HTTP_GET, [](AsyncWebServerRequest *request){
    StaticJsonDocument<300> doc;
    doc["esp32_1_temp"] = localTemp;
    doc["esp32_1_hum"] = localHum;
    doc["esp32_s3_temp"] = s3Temp;
    doc["esp32_s3_hum"] = s3Hum;
    String out; serializeJson(doc, out);
    request->send(200, "application/json", out);
  });

  server.on("/api/nodestatus", HTTP_GET, [](AsyncWebServerRequest *request){
    StaticJsonDocument<256> doc;
    doc["hub_online"] = true;
    unsigned long now = millis();
    doc["s3_online"] = (lastS3Data == 0) ? false : (now - lastS3Data < NODE_TIMEOUT * 1000);
    doc["door_online"] = (lastDoorEvent == 0) ? false : (now - lastDoorEvent < NODE_TIMEOUT * 1000);
    String out; serializeJson(doc, out);
    request->send(200, "application/json", out);
  });

  server.on("/api/data", HTTP_GET, [](AsyncWebServerRequest *request){
    String board = request->getParam("board")->value();
    String range = request->hasParam("range") ? request->getParam("range")->value() : "daily";
